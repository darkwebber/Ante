{
  "name": "ante-language",
  "displayName": "\"Ante\" Language",
  "description": "Errors as you type, hover, go to definition, rename, completion and formatting (with `antec`), plus syntax highlighting, snippets and smart indentation for the \"Ante\" programming language. Telugu lo think cheyyi, native speed lo run cheyyi.",
  "version": "0.1.0",
  "publisher": "darkwebber",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkwebber/Ante",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "ante",
    "telugu",
    "tinglish"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ante"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ante",
        "aliases": [
          "Ante",
          "ante"
        ],
        "extensions": [
          ".ante"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ante",
        "scopeName": "source.ante",
        "path": "./syntaxes/ante.tmLanguage.json"
      },
      {
        "scopeName": "markdown.ante.codeblock",
        "path": "./syntaxes/ante.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ante": "ante"
        }
      }
    ],
    "snippets": [
      {
        "language": "ante",
        "path": "./snippets/ante.json"
      }
    ],
    "configurationDefaults": {
      "[ante]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
      }
    },
    "commands": [
      {
        "command": "ante.restartServer",
        "title": "Language server restart cheyyi",
        "category": "\"Ante\""
      }
    ],
    "configuration": {
      "title": "\"Ante\"",
      "properties": {
        "ante.antecPath": {
          "type": "string",
          "default": "antec",
          "markdownDescription": "`antec` compiler ekkada undhi. Peru matrame isthe `PATH` lo (inka `~/.cargo/bin` lo) vethukuthundhi; leka full path ivvandi (relative ayithe workspace folder nunchi). Language server `antec lsp` ga start avthundhi."
        },
        "ante.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Language server (errors, hover, go to definition, rename, completion, formatting) on/off. Off ayithe highlighting matrame."
        },
        "ante.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "Editor ki `antec lsp` ki madhya messages ni Output panel lo choopinchu (debugging kosam)."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/grammar.test.js && node test/server.test.js",
    "package": "vsce package --out ante-language.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
