{
  "name": "ante-language",
  "displayName": "\"Ante\" Language",
  "description": "Syntax highlighting, snippets and smart indentation for the \"Ante\" programming language. Telugu lo think cheyyi, native speed lo run cheyyi.",
  "version": "0.1.0",
  "publisher": "darkwebber",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkwebber/Ante",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ante",
    "telugu",
    "tinglish"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ante",
        "aliases": [
          "Ante",
          "ante"
        ],
        "extensions": [
          ".ante"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ante",
        "scopeName": "source.ante",
        "path": "./syntaxes/ante.tmLanguage.json"
      },
      {
        "scopeName": "markdown.ante.codeblock",
        "path": "./syntaxes/ante.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.ante": "ante"
        }
      }
    ],
    "snippets": [
      {
        "language": "ante",
        "path": "./snippets/ante.json"
      }
    ],
    "configurationDefaults": {
      "[ante]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
      }
    }
  },
  "scripts": {
    "test": "node test/grammar.test.js",
    "package": "vsce package --out ante-language.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
