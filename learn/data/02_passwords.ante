# Data.02 · Passwords: eppudu plain text lo pettakandi 🔐
#
# Database lo passwords alaage pedithe, oka leak tho andari accounts
# poyinattu. Hash pettali, kaani SHA-256 laanti fast hash kaadhu: attacker
# second ki billion guesses try chesthaadu. Password ki kavalsindhi
# kaavalani slow ga, ekkuva memory adige hash: Argon2id.
#
# `p ni bhadram.password_hash()` prathi saari kotha random "salt" tho
# Argon2id chesi `$argon2id$v=19$m=19456,t=2,p=1$salt$hash` laanti text
# isthundhi. Same password ki rendu saarlu vere vere hashes vasthayi (salt
# valla), andhuke `==` tho kaadhu, `bhadram.password_check()` tho choodali:
# adhi constant time lo compare chesthundhi (time chusi guess cheyyalemu).
#
# Password `Rahasyam` lo untundhi: `choopinchu` chesthe `***` matrame,
# JSON lo leka log lo pettalemu (compiler aapesthundhi), drop ayinappudu
# memory zero avthundhi.
#
# Run:   antec run learn/data/02_passwords.ante
# Test:  antec pariksha learn/data/02_passwords.ante

bhadram thechuko

modhalu() -> khali ante:
    p ante "nenu-sita-123" ni Rahasyam.kotthadhi()
    f"Password: {p}" ni choopinchu()
    h ante &p ni bhadram.password_hash()
    h ni choopinchu()
    (&p ni, &h tho bhadram.password_check()) ni choopinchu()

@pariksha
sare_password() -> khali ante:
    p ante "correct horse" ni Rahasyam.kotthadhi()
    h ante &p ni bhadram.password_hash()
    ((&p ni, &h tho bhadram.password_check()) == sare(bhadram.PasswordPhalitham.Sare)) nijame()

@pariksha
thappu_password() -> khali ante:
    p ante "correct horse" ni Rahasyam.kotthadhi()
    h ante &p ni bhadram.password_hash()
    q ante "correct horse!" ni Rahasyam.kotthadhi()
    ((&q ni, &h tho bhadram.password_check()) == sare(bhadram.PasswordPhalitham.Thappu)) nijame()

@pariksha
salt_valla_vere_hash() -> khali ante:
    p ante "same" ni Rahasyam.kotthadhi()
    a ante &p ni bhadram.password_hash()
    b ante &p ni bhadram.password_hash()
    (a != b) nijame()
    (p.padham_ga() == "***") nijame()
