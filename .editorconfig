root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# L001 tests that a tab in indentation is rejected
[antec/tests/conformance/lex/L001_tab_indent.ante]
indent_style = unset
