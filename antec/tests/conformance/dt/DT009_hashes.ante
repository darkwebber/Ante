# level: services
# SHA-256, SHA-512, BLAKE3 and HMAC-SHA256 against published test vectors,
# and constant-time comparison (§27.2).
bhadram thechuko
encoding thechuko

modhalu() -> khali ante:
    abc ante "abc".baitlu_ga()
    empty: baitlu ante []
    &abc ni bhadram.sha256() |> encoding.hex() |> choopinchu()
    &empty ni bhadram.sha256() |> encoding.hex() |> choopinchu()
    &abc ni bhadram.sha512() |> encoding.hex() |> choopinchu()
    &abc ni bhadram.blake3() |> encoding.hex() |> choopinchu()
    &empty ni bhadram.blake3() |> encoding.hex() |> choopinchu()
    # The official BLAKE3 vector input: 0, 1, …, 250, 0, … (two chunks).
    maare long: baitlu ante []
    0 nunchi 1025 lopu okko i ki:
        (i % 251) ni kolpothu_maarchu[aasajeevi ankam8]() |> long.cherchu()
    &long ni bhadram.blake3() |> encoding.hex() |> choopinchu()
    key ante "key".baitlu_ga()
    fox ante "The quick brown fox jumps over the lazy dog".baitlu_ga()
    &fox ni, &key tho bhadram.hmac_sha256() |> encoding.hex() |> choopinchu()
    (&abc ni, &abc tho bhadram.okkatenaa()) ni choopinchu()
    (&abc ni, &key tho bhadram.okkatenaa()) ni choopinchu()
    (&abc ni, &empty tho bhadram.okkatenaa()) ni choopinchu()
