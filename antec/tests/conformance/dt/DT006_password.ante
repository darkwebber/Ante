# category: run-pass
# expect-stdout: avunu
# expect-stdout: sare(PasswordPhalitham.Sare)
# expect-stdout: sare(PasswordPhalitham.Thappu)
# expect-stdout: sare(PasswordPhalitham.SareKaaniMalliHashCheyyi)
# expect-stdout: thappu(password hash ardham kaaledhu (`$argon2id$v=19$m=…,t=…,p=…$salt$hash` kavali))
# level: services
# Argon2id password hashes in PHC format, checked in constant time (§27.3).
bhadram thechuko

modhalu() -> khali ante:
    p ante "correct horse battery" ni Rahasyam.kotthadhi()
    h ante &p ni bhadram.password_hash()
    ("$argon2id$v=19$m=19456,t=2,p=1$" ni h.tho_modhalaindha()) ni choopinchu()
    (&p ni, &h tho bhadram.password_check()) ni choopinchu()
    wrong ante "correct horse battery!" ni Rahasyam.kotthadhi()
    (&wrong ni, &h tho bhadram.password_check()) ni choopinchu()
    # Weaker settings than today's minimum: right, but hash it again.
    weak ante "$argon2id$v=19$m=64,t=1,p=1$c2FsdHNhbHRzYWx0c2FsdA$Wb9DOLKUgwlL5fjad9tfCPU0SBAo0PEY/evJRhwtUR0"
    old ante "password" ni Rahasyam.kotthadhi()
    (&old ni, &weak tho bhadram.password_check()) ni choopinchu()
    bogus ante "bogus"
    (&p ni, &bogus tho bhadram.password_check()) ni choopinchu()
