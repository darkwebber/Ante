# level: services
# `Kaalam` constructors, arithmetic, comparison and display; moving a
# `Gadiyaram` by a `Kaalam`, and the `theda` between two (§26).
samayam thechuko

modhalu() -> khali ante:
    90 ni samayam.Kaalam.sec() |> choopinchu()
    1500 ni samayam.Kaalam.millisec() |> choopinchu()
    250 ni samayam.Kaalam.millisec() |> choopinchu()
    2000 ni samayam.Kaalam.nanosec() |> choopinchu()
    (1 ni samayam.Kaalam.rojulu()) + (2 ni samayam.Kaalam.gantalu()) |> choopinchu()
    k ante (200 ni samayam.Kaalam.sec()) + (2 ni samayam.Kaalam.gantalu())
    k ni choopinchu()
    k.sec_lu() ni choopinchu()
    ((3 ni samayam.Kaalam.nimishalu()) < k) ni choopinchu()
    g ante ("2024-03-15T09:30:00Z" ni samayam.Gadiyaram.rfc3339_chadhuvu()).kachithanga()
    later ante k ni g.kalupu()
    later ni choopinchu()
    (g ni later.theda()) ni choopinchu()
    (500 ni samayam.Kaalam.millisec()) ni g.theesey() |> choopinchu()
