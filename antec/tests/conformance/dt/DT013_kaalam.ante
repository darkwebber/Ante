# category: run-pass
# expect-stdout: 1m 30s
# expect-stdout: 1.5s
# expect-stdout: 250ms
# expect-stdout: 2µs
# expect-stdout: 1d 2h
# expect-stdout: 2h 3m 20s
# expect-stdout: 7400.0
# expect-stdout: avunu
# expect-stdout: 2024-03-15T11:33:20Z
# expect-stdout: 2h 3m 20s
