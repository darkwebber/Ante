# category: compile-fail
# expect-error: E0603 @ 8:12
# level: core
# A `theesuko` closure can run many times, and its copies share what it
# captured, so the body can't move a captured value out (§10.7.2).
modhalu() -> khali ante:
    s ante "ab" + "c"
    f ante theesuko () => s
    f() ni choopinchu()
