# category: run-pass
# expect-stdout: Ravi from Hyderabad
# expect-stdout: Sita from Vizag
# level: core
# Default parameter used.
pilupu(peru: padham ni, ooru: padham kosam = "Hyderabad") -> padham ante:
    f"{peru} from {ooru}" icchey

modhalu() -> khali ante:
    "Ravi" ni pilupu() |> choopinchu()
    "Sita" ni, "Vizag" kosam pilupu() |> choopinchu()
