# category: run-pass
# expect-stdout: a=1, b=2, c=3
# expect-stdout: 6
# level: core
# Labelled phrases in any order.
kalupu_moodu(a: ankam ni, b: ankam ni, c: ankam ni) -> ankam ante:
    f"a={a}, b={b}, c={c}" ni choopinchu()
    (a + b + c) icchey

modhalu() -> khali ante:
    3 ni c ga, 1 ni a ga, 2 ni b ga kalupu_moodu() |> choopinchu()
